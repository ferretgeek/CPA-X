# CPA-X 面板示例配置（复制为 .env 后按需修改）
#
# 说明：
# - 面板当前默认监听 0.0.0.0:<CLIPROXY_PANEL_PANEL_PORT>，方便局域网访问；如只想本机访问，请改成 127.0.0.1。
# - 推荐在目标机器上运行 doctor 自动探测并补齐路径/服务名：python3 scripts/doctor.py --write-env
# - doctor 不会也无法自动写入明文密钥（通常配置里存的是 hash），密钥仍需你手动填入。
# - 下面路径仅为示例，必须按你的机器实际安装位置修改。

# 面板端口
CLIPROXY_PANEL_PANEL_PORT=8080

# 面板监听地址（当前默认：0.0.0.0；如只允许本机访问，改成 127.0.0.1）
CLIPROXY_PANEL_BIND_HOST=0.0.0.0

# 可选：面板访问密钥（设置后 /api/* 必须携带 X-Panel-Key；浏览器可用一次性 panel_key URL 完成录入）
CLIPROXY_PANEL_PANEL_ACCESS_KEY=

# 主配置写回默认关闭（推荐保持 false；只在你明确接受风险时才手动改成 true）
CLIPROXY_PANEL_CONFIG_WRITE_ENABLED=false

# CLIProxyAPI 管理接口地址
CLIPROXY_PANEL_CLIPROXY_API_BASE=http://127.0.0.1
CLIPROXY_PANEL_CLIPROXY_API_PORT=8317

# CLIProxyAPI 管理密钥（remote-management.secret-key 对应的明文；未启用可留空）
CLIPROXY_PANEL_MANAGEMENT_KEY=

# 用于 /v1/models 的 API Key（例如 CLIProxyAPI 配置里的 api-keys；未启用可留空）
CLIPROXY_PANEL_MODELS_API_KEY=

# systemd 服务名（用于启动/停止/重启/更新）
CLIPROXY_PANEL_CLIPROXY_SERVICE=cliproxyapi@freecodex

# CLIProxyAPI 安装与数据路径（按实际修改）
CLIPROXY_PANEL_CLIPROXY_DIR=/var/lib/cliproxyapi/freecodex
CLIPROXY_PANEL_CLIPROXY_CONFIG=/etc/cliproxyapi/freecodex/config.yaml
CLIPROXY_PANEL_CLIPROXY_BINARY=/usr/local/bin/cliproxyapi
CLIPROXY_PANEL_CLIPROXY_LOG=/var/lib/cliproxyapi/freecodex/auths/logs/main.log
CLIPROXY_PANEL_CLIPROXY_STDERR=/var/log/cliproxy/stderr.log
CLIPROXY_PANEL_AUTH_DIR=/var/lib/cliproxyapi/freecodex/auths

# 自动更新配置
CLIPROXY_PANEL_AUTO_UPDATE_ENABLED=true
CLIPROXY_PANEL_IDLE_THRESHOLD_SECONDS=900
CLIPROXY_PANEL_AUTO_UPDATE_CHECK_INTERVAL=900
# 同一失败版本首次等待 6 小时，连续失败指数退避，最长 24 小时
CLIPROXY_PANEL_AUTO_UPDATE_FAILURE_BACKOFF_SECONDS=21600
CLIPROXY_PANEL_AUTO_UPDATE_FAILURE_BACKOFF_MAX_SECONDS=86400
# 更新后同时等待 systemd active 与真实管理接口 /v0/management/config 返回 200
CLIPROXY_PANEL_SERVICE_HEALTH_TIMEOUT_SECONDS=45

# CLIProxy 日志时区：推荐 auto；也支持 local、UTC、+08:00、Asia/Shanghai 等 IANA 时区
# auto 会用日志时间与文件 mtime 推断偏移，容器时区与宿主机不一致时也能正常工作
CLIPROXY_PANEL_LOG_TIMEZONE=auto

# 首次最多扫描多少 MiB 历史日志，避免巨型日志拖慢面板启动/首屏
CLIPROXY_PANEL_LOG_INITIAL_SCAN_MAX_MB=64

# 默认禁止面板截断服务日志；页面“清空”只清除当前浏览器显示
CLIPROXY_PANEL_LOG_CLEAR_ENABLED=false

# 自动更新备份：同时限制数量、保留天数和总逻辑大小，避免磁盘持续膨胀
CLIPROXY_PANEL_BACKUP_RETENTION_COUNT=2
CLIPROXY_PANEL_BACKUP_MAX_AGE_DAYS=14
CLIPROXY_PANEL_BACKUP_MAX_TOTAL_MB=512

# 默认必须通过上游 checksums.txt 的 SHA-256 校验后才允许替换二进制
CLIPROXY_PANEL_UPDATE_REQUIRE_CHECKSUM=true

# Token 价格（美元/百万 Tokens）
CLIPROXY_PANEL_PRICING_INPUT=0
CLIPROXY_PANEL_PRICING_OUTPUT=0
CLIPROXY_PANEL_PRICING_CACHE=0

# 价格自动同步（默认开启；当手动价格为 0 时会尝试从权威来源补齐）
CLIPROXY_PANEL_PRICING_AUTO_ENABLED=true
# 目前支持：openrouter
CLIPROXY_PANEL_PRICING_AUTO_SOURCE=openrouter
# 为空时会从 config.yaml 里挑一个模型；最后回退到 openai/gpt-4o-mini
CLIPROXY_PANEL_PRICING_AUTO_MODEL=

# 扩展语录库；项目根目录 X.txt 会被强制加载，此路径若不同则作为附加语录源
CLIPROXY_PANEL_QUOTES_PATH=./X.txt

# 可选：允许跨域访问 /api/* 的来源，多个来源用逗号分隔；留空表示仅同源
CLIPROXY_PANEL_CORS_ORIGINS=

# 可选：GitHub Token（提升更新检查限流额度，不配置也能工作）
CLIPROXY_PANEL_GITHUB_TOKEN=
